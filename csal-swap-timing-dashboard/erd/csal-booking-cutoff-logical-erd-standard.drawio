        <mxCell id="source_mapping" value="Source mapping (separate from ERD): NRT case ← csal_teu_performance_nrt | Shipment profile ← csal_shipment | Timing result ← csal_tcr_tiered_match_v2&lt;br&gt;Logical identifiers are derived for this analysis; physical Databricks PK/FK constraints are not confirmed." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#667085;" parent="1" vertex="1">
